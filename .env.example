# Optional: you can enter the API key in the application's Model dialog instead.
COURSEFIT_PROVIDER=deepseek
COURSEFIT_API_KEY=
# The model can also be changed in Model.
COURSEFIT_MODEL=deepseek-flash
# Only used when COURSEFIT_PROVIDER=custom.
COURSEFIT_BASE_URL=
COURSEFIT_PROTOCOL=openai
PORT=3000
