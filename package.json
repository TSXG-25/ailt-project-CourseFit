{
  "name": "coursefit",
  "version": "0.1.0",
  "private": true,
  "description": "A local, confirmation-first timetable planner for AILT9019.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test",
    "evaluate:parsing": "node --env-file-if-exists=.env scripts/evaluate-parsing.js"
  },
  "dependencies": {
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  }
}
